# Local development only. Do not reuse these values outside this machine.
APP_ENV=development
APP_HTTP_ADDR=:8080
APP_LOG_LEVEL=debug

POSTGRES_USER=wagering
POSTGRES_PASSWORD=local-wagering-password
POSTGRES_DB=wagering
POSTGRES_PORT=5432
DATABASE_URL=postgres://wagering:local-wagering-password@localhost:5432/wagering?sslmode=disable

AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
SQS_ENDPOINT=http://localhost:4566
SQS_TRANSACTIONS_QUEUE_URL=http://localhost:4566/queue/us-east-1/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/queue/us-east-1/000000000000/wager-events.fifo

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-password
KEYCLOAK_PORT=8081
KEYCLOAK_HEALTH_PORT=9000
OIDC_ISSUER_URL=http://localhost:8081/realms/wagering-local
OIDC_AUDIENCE=wagering-api
OIDC_INTERNAL_CLIENT_ID=internal-service
API_BASE_URL=http://localhost:8080
OIDC_PROVIDER_CLIENT_ID=provider-alpha
OIDC_PROVIDER_CLIENT_SECRET=local-provider-alpha-secret
OIDC_INTERNAL_CLIENT_SECRET=local-internal-service-secret
PROVIDER_ID=provider-alpha

# Local Keycloak credentials used only by the opt-in authenticated integration test.
OIDC_TEST_PROVIDER_ALPHA_SECRET=local-provider-alpha-secret
OIDC_TEST_PROVIDER_BETA_SECRET=local-provider-beta-secret
OIDC_TEST_INTERNAL_SECRET=local-internal-service-secret